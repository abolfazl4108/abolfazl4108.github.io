<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>آمار ساعتی بسته‌بندی</title>
    <link rel="stylesheet" href="https://unpkg.com/@majidh1/jalalidatepicker/dist/jalalidatepicker.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    
    <style>
        body { font-family: Tahoma, sans-serif; padding: 10px; background-color: #f4f7f6; font-size: 16px; }
        .app-header { text-align: center; color: #6c5ce7; font-weight: 900; font-size: 24px; margin-bottom: 15px; }
        
        .tabs { display: flex; gap: 10px; margin-bottom: 20px; justify-content: center; }
        .tab-btn { padding: 10px 25px; cursor: pointer; background-color: #a29bfe; color: white; border: none; border-radius: 8px; font-weight: bold; transition: 0.3s; }
        .tab-btn.active { background-color: #6c5ce7; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        .container { background: #fff; padding: 10px; border-radius: 8px; border: 1px solid #6c5ce7; margin-bottom: 10px; }
        .section-title { text-align: center; color: #6c5ce7; font-weight: bold; font-size: 18px; margin-bottom: 8px; border-bottom: 1px solid #6c5ce7; padding-bottom: 5px; }
        .row { display: flex; gap: 10px; margin-bottom: 8px; }
        .field { flex: 1; }
        .checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
        
        input, select { 
            width: 100%; 
            height: 38px; 
            padding: 0 8px; 
            border: 1px solid #6c5ce7; 
            border-radius: 4px; 
            box-sizing: border-box; 
            text-align: center; 
            font-family: Tahoma, sans-serif; 
        }
        textarea { 
            width: 100%; 
            height: 38px; 
            padding: 8px; 
            border: 1px solid #6c5ce7; 
            border-radius: 4px; 
            box-sizing: border-box; 
            text-align: right; 
            resize: vertical; 
            font-family: Tahoma, sans-serif; 
        }
        
        .selectable-item { cursor: pointer; display: flex; align-items: center; justify-content: space-between; padding: 5px 8px; border: 1px solid #ddd; border-radius: 4px; font-size: 14px; }
        .active-text { color: #6c5ce7 !important; font-weight: bold; border-color: #6c5ce7; background-color: #f3f0ff; }
        
        .reset-row { display: flex; justify-content: center; gap: 5px; margin-top: 10px; }
        .btn-reset { cursor: pointer; background: #d63031; color: white; border: none; padding: 8px 15px; border-radius: 6px; font-weight: bold; }
        .btn-export { background: #00b894 !important; }

        .exporting-mode {
            font-size: 13px !important;
            line-height: 1.3 !important;
            padding: 20px !important;
            box-sizing: border-box;
        }
        .exporting-mode input, 
        .exporting-mode select {
            height: 28px !important;
            font-size: 12px !important;
            padding: 0 4px !important;
        }
        .exporting-mode textarea {
            height: 32px !important;
            font-size: 12px !important;
            padding: 4px !important;
        }
        .exporting-mode .selectable-item {
            font-size: 11px !important;
            padding: 3px 6px !important;
        }
        .exporting-mode .section-title {
            font-size: 15px !important;
            margin-bottom: 5px !important;
            padding-bottom: 3px !important;
        }
        .exporting-mode .container {
            padding: 8px !important;
            margin-bottom: 8px !important;
        }
        .exporting-mode .row {
            margin-bottom: 5px !important;
            gap: 6px !important;
        }
    </style>
</head>
<body>

<div class="app-header">آمار ساعتی بسته‌بندی</div>

<div class="tabs">
    <button class="tab-btn active" onclick="openTab(event, 'line1')">خط 1</button>
    <button class="tab-btn" onclick="openTab(event, 'line2')">خط 2</button>
    <button class="tab-btn" onclick="openTab(event, 'line3')">خط 3</button>
</div>

<div id="line1" class="tab-content active"></div>
<div id="line2" class="tab-content"></div>
<div id="line3" class="tab-content"></div>

<script src="https://unpkg.com/@majidh1/jalalidatepicker/dist/jalalidatepicker.min.js"></script>
<script>
    jalaliDatepicker.startWatch();
    const productionList = ["ترک", "نخاله", "اشغال سطح", "باند چاپ", "خط هد", "چکه رنگ", "چکه آب", "جذب آب", "سایز", "قوس", "چمفر ناقص", "گوشه پریدگی", "لبه کندگی", "خط و خش", "لکه پولیش", "لکه نانو", "ماتی لبه", "کچلی", "پاک شدگی", "خرابی چمفر", "پخ", "دندون موشی", "کاشی ترک دار", "سوراخ سطح", "برفکی سطح", "پارگی لعاب", "خط ولا", "نخوردن مواد c", "دوپوست لبه", "ترک رطوبتی", "سوراخ تجمعی", "کندگی سطح","جوش"];
    const wasteList = ["کاشی سفید", "گوشه شکسته", "حباب", "ترک دار", "دوپوست", "رد موتور", "کاشی تست کنترل", "کاشی تست طراحی", "دوپوست"];

    const lines = ['line1', 'line2', 'line3'];
    lines.forEach(lineId => {
        const container = document.getElementById(lineId);
        container.innerHTML = `
            <div class="export-title" style="display:none; text-align:center; font-size: 18px; font-weight:bold; margin-bottom: 8px; color: #6c5ce7;">آمار ساعتی بسته‌بندی - ${lineId === 'line1' ? 'خط 1' : lineId === 'line2' ? 'خط 2' : 'خط 3'}</div>
            <div class="container">
                <div class="row">
                    <div class="field"><label>شیفت:</label><select><option>A</option><option>B</option><option>C</option></select></div>
                    <div class="field"><label>تاریخ:</label><input type="text" class="dateInput" data-jdp readonly></div>
                </div>
                <div class="row">
                    <div class="field"><label>ساعت شروع:</label><input type="time"></div>
                    <div class="field"><label>ساعت پایان:</label><input type="time"></div>
                </div>
            </div>
            <div class="container">
                <div class="section-title">درصد تولیدات</div>
                <div class="row"><div class="field"><label>درجه 1:</label><input type="number"></div><div class="field"><label>درجه 2:</label><input type="number"></div><div class="field"><label>درجه 4:</label><input type="number"></div></div>
                <div class="row"><div class="field"><label>درجه 5:</label><input type="number"></div><div class="field"><label>تعداد برگ درجه 6:</label><input type="number"></div></div>
            </div>
            <div class="container">
                <div class="section-title">افت تولیدات</div>
                <div class="checkbox-grid prod-${lineId}" style="margin-bottom: 10px;"></div>
                <div class="field prod-desc-wrapper">
                    <label style="display: block; margin-bottom: 5px; font-weight: bold; color: #6c5ce7;">توضیحات:</label>
                    <textarea class="prod-desc-input" placeholder="توضیحات خود را اینجا وارد کنید..."></textarea>
                </div>
            </div>
            <div class="container">
                <div class="section-title">ضایعات کاشی</div>
                <div class="checkbox-grid waste-${lineId}" style="margin-bottom: 10px;"></div>
                <div class="field waste-desc-wrapper">
                    <label style="display: block; margin-bottom: 5px; font-weight: bold; color: #6c5ce7;">توضیحات:</label>
                    <textarea class="waste-desc-input" placeholder="توضیحات خود را اینجا وارد کنید..."></textarea>
                </div>
            </div>
            <div class="reset-row">
                <button class="btn-reset btn-export" onclick="exportAsImage('${lineId}')">خروجی عکس</button>
                <button class="btn-reset" onclick="confirmReset('${lineId}')">بازنشانی</button>
            </div>
        `;
        
        const prodCont = container.querySelector(`.prod-${lineId}`);
        const wasteCont = container.querySelector(`.waste-${lineId}`);
        productionList.forEach(item => prodCont.appendChild(createItem(item)));
        wasteList.forEach(item => wasteCont.appendChild(createItem(item)));
    });

    function createItem(text) {
        const label = document.createElement('label');
        label.className = "selectable-item";
        label.innerHTML = `<input type="checkbox" style="display:none;"> <span>${text}</span>`;
        label.onclick = function() {
            const cb = this.querySelector('input');
            cb.checked = !cb.checked;
            this.classList.toggle('active-text', cb.checked);
        };
        return label;
    }

    function confirmReset(lineId) {
        if (confirm("در صورت زدن تایید تمامی اطلاعات به حال اولیه باز می گردد!")) {
            const container = document.getElementById(lineId);
            container.querySelectorAll('input').forEach(input => {
                if (input.type === 'checkbox') {
                    input.checked = false;
                    input.parentElement.classList.remove('active-text');
                } else {
                    input.value = '';
                }
            });
            container.querySelectorAll('select').forEach(select => select.selectedIndex = 0);
            container.querySelectorAll('textarea').forEach(textarea => textarea.value = '');
        }
    }

    function openTab(evt, lineId) {
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById(lineId).classList.add('active');
        evt.currentTarget.classList.add('active');
    }

    // ===== بخش جدید: مدیریت ذخیره‌سازی مسیر با تیک یادآوری =====
    let savePath = localStorage.getItem('defaultSavePath') || '';
    let rememberPath = localStorage.getItem('rememberPath') === 'true';

    function askSavePathWithReminder() {
        return new Promise((resolve) => {
            // اگر مسیر ذخیره شده و تیک یادآوری فعال است
            if (rememberPath && savePath) {
                resolve(true);
                return;
            }
            
            // نمایش دیالوگ انتخاب مسیر با تیک یادآوری
            if (window.Android && window.Android.showSaveDialog) {
                try {
                    const result = window.Android.showSaveDialog(savePath);
                    if (result) {
                        const [path, remember] = result.split('|');
                        if (path) {
                            savePath = path;
                            rememberPath = remember === 'true';
                            localStorage.setItem('defaultSavePath', savePath);
                            localStorage.setItem('rememberPath', rememberPath.toString());
                            resolve(true);
                        } else {
                            resolve(false);
                        }
                    } else {
                        resolve(false);
                    }
                } catch (e) {
                    resolve(false);
                }
            } else {
                // در مرورگر، از کاربر می‌خواهیم مسیر را انتخاب کند
                const path = prompt('لطفاً مسیر ذخیره عکس را وارد کنید:', savePath || '/sdcard/Download/');
                if (path !== null && path.trim() !== '') {
                    savePath = path.trim();
                    localStorage.setItem('defaultSavePath', savePath);
                    
                    // در مرورگر، تیک یادآوری با یک confirm ساده شبیه‌سازی می‌شود
                    const remember = confirm('آیا می‌خواهید این مسیر را برای دفعات بعد ذخیره کنید؟');
                    rememberPath = remember;
                    localStorage.setItem('rememberPath', rememberPath.toString());
                    resolve(true);
                } else {
                    resolve(false);
                }
            }
        });
    }

    function downloadImageWithPath(imageData, lineId) {
        const fileName = `Report_${lineId}_${new Date().getTime()}.png`;
        
        // اگر مسیر ذخیره شده وجود دارد، به اندروید اطلاع بده
        if (window.Android && window.Android.saveImageWithPath) {
            try {
                window.Android.saveImageWithPath(imageData, savePath, fileName);
                return;
            } catch (e) {
                // ادامه با روش معمولی
            }
        }
        
        // روش معمولی دانلود
        const link = document.createElement('a');
        link.download = fileName;
        link.href = imageData;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        
        setTimeout(() => {
            URL.revokeObjectURL(imageData);
        }, 1000);
    }

    // ===== تابع اصلی خروجی عکس با تغییرات =====
    async function exportAsImage(lineId) {
        // ابتدا از کاربر برای انتخاب مسیر سوال می‌کنیم
        const canSave = await askSavePathWithReminder();
        if (!canSave) {
            alert('ذخیره عکس لغو شد.');
            return;
        }

        const element = document.getElementById(lineId);
        const title = element.querySelector('.export-title');
        title.style.display = 'block';
        
        element.classList.add('exporting-mode');
        
        element.querySelectorAll('.selectable-item').forEach(item => {
            if (!item.querySelector('input').checked) item.style.display = 'none';
        });

        const prodDescWrapper = element.querySelector('.prod-desc-wrapper');
        const prodDescInput = element.querySelector('.prod-desc-input');
        if (!prodDescInput.value.trim()) {
            prodDescWrapper.style.display = 'none';
        }

        const wasteDescWrapper = element.querySelector('.waste-desc-wrapper');
        const wasteDescInput = element.querySelector('.waste-desc-input');
        if (!wasteDescInput.value.trim()) {
            wasteDescWrapper.style.display = 'none';
        }

        element.querySelector('.reset-row').style.display = 'none';

        try {
            const canvas = await html2canvas(element, { 
                scale: 3,
                backgroundColor: "#ffffff",
                useCORS: true,
                logging: false,
                allowTaint: true,
                width: element.scrollWidth,
                height: element.scrollHeight,
                windowWidth: element.scrollWidth,
                windowHeight: element.scrollHeight
            });
            
            // بازیابی نمایش المان‌ها
            title.style.display = 'none';
            element.classList.remove('exporting-mode');
            element.querySelectorAll('.selectable-item').forEach(item => item.style.display = '');
            prodDescWrapper.style.display = 'block';
            wasteDescWrapper.style.display = 'block';
            element.querySelector('.reset-row').style.display = 'flex';

            const imageData = canvas.toDataURL("image/png", 1.0);
            
            // ذخیره با مسیر انتخاب شده
            if (window.Android && window.Android.saveImageWithPath) {
                try {
                    window.Android.saveImageWithPath(imageData, savePath, `Report_${lineId}_${new Date().getTime()}.png`);
                    alert('عکس با موفقیت ذخیره شد.');
                } catch (e) {
                    downloadImageWithPath(imageData, lineId);
                }
            } else {
                downloadImageWithPath(imageData, lineId);
            }
        } catch (error) {
            console.error("خطا در تولید عکس:", error);
            alert("خطا در تولید عکس. لطفاً دوباره تلاش کنید.");
            // بازیابی نمایش در صورت خطا
            title.style.display = 'none';
            element.classList.remove('exporting-mode');
            element.querySelectorAll('.selectable-item').forEach(item => item.style.display = '');
            prodDescWrapper.style.display = 'block';
            wasteDescWrapper.style.display = 'block';
            element.querySelector('.reset-row').style.display = 'flex';
        }
    }
</script>
</body>
</html>
